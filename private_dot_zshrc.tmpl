# Interactive zsh config, rendered by chezmoi from ~/dotfiles/private_dot_zshrc.tmpl.
# Edit with `zshrc` (alias below), not in place: `chezmoi apply` would overwrite it.

###################
### Environment ###
###################

# Set before oh-my-zsh, so OMZ and its plugins see the final PATH.
export EDITOR='vim'
export GPG_TTY=$(tty)
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
export DYLD_LIBRARY_PATH="/opt/homebrew/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"

# PATH, highest priority first. `typeset -U` drops duplicates (nested shells).
typeset -U path
path=(
  $HOME/.local/bin
  ${KREW_ROOT:-$HOME/.krew}/bin
  # GNU coreutils under their plain names (ls, date, sed...) instead of the BSD ones.
  /opt/homebrew/opt/coreutils/libexec/gnubin
  $HOME/go/bin
  $path
)

# mise: global & per-project tool versions (node, python, npm tools), see ~/.config/mise/config.toml
eval "$(mise activate zsh)"

#################
### oh-my-zsh ###
#################

export ZSH="$HOME/.oh-my-zsh"
# Custom themes/plugins live in this repo (dot_config/oh-my-zsh), not in the OMZ checkout.
ZSH_CUSTOM="$HOME/.config/oh-my-zsh"
ZSH_THEME="kardan-color"

zstyle ':omz:update' mode auto      # update automatically without asking
zstyle ':omz:update' frequency 13
# GNU coreutils are first on PATH, where OMZ's default macOS `ls -G` means
# "no group column" rather than "color": use `gls --color` instead.
zstyle ':omz:lib:theme-and-appearance' gnu-ls yes

# Command line: grey suggestions from history (→ to accept), and highlighting as you type
# (red = unknown command, green = valid, plus matching brackets).
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# zsh-syntax-highlighting must come last: it wraps the widgets defined by the others.
plugins=(git kubectl kube-ps1 colored-man-pages zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Completion menus in the same colors as `ls` (OMZ leaves them uncolored).
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# History: OMZ keeps only 10k lines on disk. Set after OMZ, which overrides these.
HISTSIZE=100000
SAVEHIST=100000

###################
### Completions ###
###################

source <(kubie generate-completion)

# fzf: Ctrl-R fuzzy history, Ctrl-T file picker, Alt-C fuzzy cd
source <(fzf --zsh)
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"

###########################
### Aliases & functions ###
###########################

# ~/.zshrc is rendered by chezmoi: edit the source template, then apply.
alias zshrc="chezmoi edit --apply ~/.zshrc"
alias history="omz_history -i"
alias update="brew update && brew upgrade && brew cleanup"

# Run Homebrew without GNU coreutils on PATH: source builds (e.g. GMP) expect the BSD tools.
brew() { PATH=${PATH//\/opt\/homebrew\/opt\/coreutils\/libexec\/gnubin:/} command brew "$@" }

# Clean Git repositories: fetch/prune, prune stale worktrees, fast-forward the default branch, delete branches whose remote is gone.
# Usage: gitclean [repo_path] (no path: every repo below the current dir)
gitclean() {
  _gitclean_one() {
    local cur def
    echo "--- $(pwd)"
    git fetch --prune -q || { echo "fetch failed, skipping" >&2; return 1; }
    # Stale worktrees keep their branch checked out, which blocks its deletion
    git worktree prune
    def=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && def=${def#origin/}
    [[ -z $def ]] && git show-ref -q --verify refs/remotes/origin/main && def=main
    [[ -z $def ]] && def=master
    cur=$(git branch --show-current)
    # Leave the current branch alone unless its remote is gone
    if [[ -n $cur && $cur != $def && $(git for-each-ref --format='%(upstream:track)' "refs/heads/$cur") == "[gone]" ]]; then
      git checkout -q "$def" || return 1
      cur=$def
    fi
    if [[ $cur == $def ]]; then
      [[ -z $(git status --porcelain) ]] && git pull -q --ff-only
    else
      git fetch -q origin "$def:$def" 2>/dev/null # fast-forward default branch without switching
    fi
    git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
      | awk '$2=="[gone]" {print $1}' | xargs -r git branch -D
  }

  if [[ $# -eq 1 ]]; then
    [[ -d $1/.git ]] || { echo "Error: '$1' is not a Git repository." >&2; return 1; }
    (cd "$1" && _gitclean_one)
  else
    find . -mindepth 2 -name .git -type d -prune -print0 \
      | while IFS= read -r -d '' g; do (cd "${g:h}" && _gitclean_one); done
  fi
  unfunction _gitclean_one 2>/dev/null
}

###############
### Secrets ###
###############

# Secrets are stored in the macOS Keychain (see README) and injected here at
# `chezmoi apply` time — never written to this template in plaintext.
export CODESTRAL_API_KEY="{{ keyring "codestral-api-key" .chezmoi.username }}"

#####################
### Machine-local ###
#####################

# Job-specific config (env, PATH, tokens) lives in ~/.zshrc.work, rendered by
# chezmoi from a git-ignored source file so it never reaches the public repo.
[ -f ~/.zshrc.work ] && source ~/.zshrc.work
