alias zshrc="vim ~/.zshrc"
alias history="omz_history -i"
alias update="brew update && brew upgrade && brew cleanup"
alias goclean="go clean -cache -testcache -modcache -fuzzcache"

# Clean Git repositories: fetch/prune, checkout default branch, optional pull on main/master, delete stale branches.
# Usage: gitclean [repo_path] (if no path, runs recursively from depth 2)
gitclean() {
  _gitclean_one() {
    local current_branch default_branch
    current_branch=$(git branch --show-current)

    echo "--- Cleaning $(pwd) ---"
    if ! git fetch --prune; then
      echo "Warning: fetch failed, skipping $(pwd)." >&2
      return 1
    fi

    # Determine default branch (main or master)
    if git show-ref --verify --quiet refs/remotes/origin/main; then
      default_branch="main"
    elif git show-ref --verify --quiet refs/remotes/origin/master; then
      default_branch="master"
    fi

    # Checkout default branch first, so a stale current branch can be deleted below
    if [[ -n "$default_branch" ]] && [[ "$current_branch" != "$default_branch" ]]; then
      echo "Checking out $default_branch..."
      if ! git checkout "$default_branch" 2>/dev/null; then
        # Try checking out from remote if local doesn't exist
        if git show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
          git checkout --track "origin/$default_branch"
        else
          echo "Warning: Cannot checkout default branch $default_branch." >&2
        fi
      fi
      current_branch=$(git branch --show-current)
    fi

    # Pull (fast-forward only) if on main/master and clean
    if [ -z "$(git status --porcelain)" ] && [[ "$current_branch" =~ ^(main|master)$ ]]; then
      echo "Pulling $current_branch..."
      git pull --ff-only
    fi

    # Delete local branches whose remote counterpart is gone
    echo "Deleting stale local branches..."
    git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads \
      | awk '$2=="[gone]" {print $1}' | xargs -r git branch -D

    echo "--- Done $(pwd) ---"
  }

  if [ $# -eq 1 ]; then
    if [[ -d "$1/.git" ]]; then
      pushd "$1" > /dev/null; _gitclean_one; popd > /dev/null
    elif [[ "$1" == "." && -d ".git" ]]; then # Allow 'gitclean .'
      _gitclean_one
    else
      echo "Error: '$1' is not a Git repository." >&2; return 1
    fi
  else
    # Find git repos starting 2 levels deep and process them
    find . -mindepth 2 -type d -name .git -print0 | while IFS= read -r -d $'\0' gitdir; do
      local dir
      dir=$(dirname "$gitdir") # Get parent directory of .git
      if [[ -d "$dir" ]]; then # Ensure it's a directory before proceeding
        pushd "$dir" > /dev/null
        _gitclean_one
        popd > /dev/null
      fi
    done
  fi

  unfunction _gitclean_one 2>/dev/null
}

export PATH="$HOME/go/bin:$PATH"

export GPG_TTY=$(tty)

export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

source <(kubie generate-completion)

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

. "$HOME/.local/bin/env"
export DYLD_LIBRARY_PATH="/opt/homebrew/lib:$DYLD_LIBRARY_PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/antoinegelloz/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/antoinegelloz/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/antoinegelloz/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/antoinegelloz/google-cloud-sdk/completion.zsh.inc'; fi

export PATH="/Users/antoinegelloz/.terragrunt/bin:$PATH"

# Secrets are stored in the macOS Keychain (see README) and injected here at
# `chezmoi apply` time — never written to this template in plaintext.
export CODESTRAL_API_KEY="{{ keyring "codestral-api-key" .chezmoi.username }}"

export GITLAB_TOKEN="{{ keyring "gitlab-token" .chezmoi.username }}"
export LINODE_TOKEN="{{ keyring "linode-token" .chezmoi.username }}"
