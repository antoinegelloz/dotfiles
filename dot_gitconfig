# Global git config. Job-specific overrides are included from ~/.gitconfig.work (see bottom).

[user]
	name = Antoine Gelloz
	email = antoine.gelloz@gmail.com
	username = antoinegelloz
	signingkey = /Users/antoinegelloz/.ssh/id_ed25519.pub

[core]
	editor = /usr/bin/vim
	untrackedCache = true
	fsmonitor = false

# Always use SSH for GitHub, even for https:// URLs
[url "git@github.com:"]
	insteadOf = https://github.com/

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true

# Sign commits and tags with the SSH key
[commit]
	verbose = true
	gpgSign = true

[tag]
	sort = version:refname
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	# Lets `git log --show-signature` / `git verify-commit` verify your own commits
	allowedSignersFile = ~/.config/git/allowed_signers

# Defaults from https://blog.gitbutler.com/how-git-core-devs-configure-git/
[column]
	ui = auto

[branch]
	sort = -committerdate

[init]
	defaultBranch = main

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[pull]
	rebase = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt

[feature]
	experimental = false

# Machine-local / job-specific overrides (not in the public repo; ignored if missing)
[include]
	path = ~/.gitconfig.work
