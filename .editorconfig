# Shared formatting rules (editors, shfmt). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.sh,.githooks/*}]
switch_case_indent = true

[{dot_gitconfig,dot_gitconfig.*}]
indent_style = tab

[Makefile]
indent_style = tab
